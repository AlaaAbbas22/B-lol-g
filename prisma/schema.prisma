// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


// Add these models to your existing schema

model PostView {
  id          String   @id @default(cuid())
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  visitorHash String?  // Hash of IP address for anonymous users
  ipAddress   String?  // IP address (stored only for anonymous users)
  deviceType  String   // "desktop", "mobile", "tablet"
  viewedAt    DateTime @default(now())

  @@index([postId])
  @@index([userId])
  @@index([visitorHash])
}

// Update the Post model to add viewCount and views relation
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String   
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  meowedBy  User[]   @relation("UserMeows") // New relation for users who meowed
  meowCount Int      @default(0) // Counter for meows
  viewCount Int       @default(0)
  views     PostView[]
}

// Update the User model to add views relation
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  posts         Post[]
  meowedPosts   Post[]    @relation("UserMeows") // New relation for meowed posts
  views     PostView[]
}
